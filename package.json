{
  "name": "dsh-shell-edit-guard",
  "private": true,
  "description": "Shell file-edit guard: refuses shell commands that edit files by hand, so the model uses the write/edit tools and keeps the version guard and read-before-edit policy",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dofine/dsh-shell-edit-guard.git"
  },
  "homepage": "https://github.com/dofine/dsh-shell-edit-guard#readme",
  "bugs": {
    "url": "https://github.com/dofine/dsh-shell-edit-guard/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "guard",
    "shell",
    "filesystem"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-include": "^1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2",
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
